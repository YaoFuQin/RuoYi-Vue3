# 页面标题
VITE_APP_TITLE = 报价管理系统

# 生产环境配置
VITE_APP_ENV = 'production'

# 报价管理系统/生产环境
VITE_APP_BASE_API = '/prod-api'

# 报价管理系统/开发环境
# VITE_APP_BASE_API = 'http://192.168.0.103:8080'
VITE_APP_BASE_API = 'https://yilaapi.openhola.com'

# 图片预览地址
# VITE_APP_VIEW_IMG_URL = 'http://192.168.0.103:8080'
VITE_APP_VIEW_IMG_URL = 'https://yilaapi.openhola.com'


# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip